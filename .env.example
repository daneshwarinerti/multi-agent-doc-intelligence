# Gemini API Key (Get from Google AI Studio)
GOOGLE_API_KEY=your_gemini_api_key_here

# Default Gemini Agent Model
DEFAULT_MODEL=gemini-3.5-flash-lite

# Gemini Multimodal Embedding Model (1536 dimensions)
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=1536

# Database path for ChromaDB persistent storage
CHROMA_DB_DIR=./chroma_db

# Production CORS Allowed Origins (comma-separated list of origins, e.g. https://your-app.onrender.com)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
